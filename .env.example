# Copy this file to .env.local and fill in the values.
# Add the same variables in Vercel > Project > Settings > Environment Variables.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — never expose, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (captcha) — use test keys locally:
# site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Admin "Continue with Google" button. Set to true only after enabling the Google
# provider in Supabase > Authentication > Providers. Needs a rebuild/redeploy to change.
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=false

# Resend (emails)
RESEND_API_KEY=
EMAIL_FROM="Matiks College League <league@matiks.com>"

# Public site URL (used in emails, share links, OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Launch (migration 0007)
# Signs 30-second duel rounds. SERVER ONLY: a long random string (e.g. openssl rand -base64 48).
DUEL_SECRET=
# "Play real duels on the Matiks app" link.
NEXT_PUBLIC_MATIKS_APP_URL=https://www.matiks.com
# LinkedIn company page ID for "Add to LinkedIn profile" (certificates). Empty = organizationName "Matiks".
NEXT_PUBLIC_LINKEDIN_ORG_ID=
